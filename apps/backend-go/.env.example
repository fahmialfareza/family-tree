# Copy to .env and fill in. Never commit real values.

# Required
DATABASE_URL=postgres://user:pass@localhost:5432/family-tree?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Optional: Redis (rate limiting + caching)
REDIS_URL=redis://localhost:6379

# Optional: Cloudinary uploads (falls back to local UPLOAD_DIR when unset)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
UPLOAD_DIR=./tmp

# Optional: New Relic APM
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=family-tree-backend
NEW_RELIC_LICENSE_KEY=

# Optional: verbose tree endpoint logging (1 to enable)
TREE_DEBUG=0
