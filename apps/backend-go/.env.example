# Copy to .env and fill in. Never commit real values.

# Required
DATABASE_URL=postgres://user:pass@localhost:5432/family-tree?sslmode=disable
# Signs access tokens and OAuth state. The server refuses to start without it. Use 32+ random bytes,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Public URLs: the frontend (used in email links and after Google sign-in) and this API (OAuth callback).
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# production: refuse to start without Redis, Resend, https URLs, a 32+ char JWT_SECRET, ALLOWED_ORIGINS and a
# client-IP setting. Also switches logs to JSON, gin to release mode and enables HSTS.
APP_ENV=development

# CORS: comma-separated exact origins (scheme://host[:port], no path). Unset = http://localhost:3000 outside
# production; required with APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection pool (defaults 20 open / 10 idle). Keep open * instances below the server's max_connections.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Shared with the frontend server (same value there). Requests carrying it may name the visitor's IP in
# X-Client-IP; without it every visitor would share the frontend's IP for rate limits. 32+ random characters;
# required with APP_ENV=production.
BFF_SHARED_SECRET=

# Client IPs for requests without the BFF secret (direct API calls). Pick one:
#   CLIENT_IP_HEADER=X-Real-IP        a header your platform's edge always overwrites (e.g. CF-Connecting-IP)
#   TRUSTED_PROXIES=10.0.0.0/8,...    honour X-Forwarded-For only from these peers
#   TRUSTED_PROXIES=none              always use the direct peer address
# Unset = X-Forwarded-For is trusted from anyone (warning; not allowed with APP_ENV=production).
CLIENT_IP_HEADER=
TRUSTED_PROXIES=

# Optional: transactional email via Resend. Without a key, emails are printed to the log (dev only).
RESEND_API_KEY=
EMAIL_FROM=Sakdulur <noreply@sakdulur.com>

# Optional: Google sign-in. Authorized redirect URI: ${API_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Desktop/mobile apps (apps/native). URL scheme the app registers (its app id); Google sign-in started in the app
# returns there. Leave empty to disable the app flow.
MOBILE_APP_SCHEME=com.fahmialfareza.sakdulur

# Optional: Sign in with Apple (required for the iOS app because Google sign-in is offered).
# APPLE_CLIENT_IDS: accepted token audiences, comma-separated (the iOS bundle id).
# APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY: a "Sign in with Apple" key (.p8, newlines as \n). Optional but
# needed to revoke Apple tokens when an account is deleted, which App Review checks.
APPLE_CLIENT_IDS=
# APPLE_SERVICES_ID: Services ID for Sign in with Apple on the web (also list it in APPLE_CLIENT_IDS). Its return
# URL is <API_BASE_URL>/api/auth/apple/callback over HTTPS (Apple allows no localhost).
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional: AI assistant ("ask about this tree"). Providers are tried in this order: Gemini, then Groq; a provider
# is on when its key is set. Model lists are comma-separated and tried in order;
# a model that is rate limited or failing is skipped for a while. Owners still have to turn the assistant on per tree.
# Gemini's free tier may use prompts to improve Google's products: enable billing on the Gemini key for real
# family data.
GEMINI_API_KEY=
AI_GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GROQ_API_KEY=
AI_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Per-model timeout and questions per user per day.
AI_PROVIDER_TIMEOUT=25s
AI_DAILY_LIMIT=100

# Optional: Redis (rate limiting + caching)
REDIS_URL=redis://localhost:6379

# Optional: Cloudinary photo uploads. Without it, development stores photos in UPLOAD_DIR (served at /uploads)
# and production rejects photo uploads.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
UPLOAD_DIR=./tmp

# Optional: New Relic APM
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=family-tree-backend
NEW_RELIC_LICENSE_KEY=

# Optional: debug-level logs for the tree endpoints (1 to enable)
TREE_DEBUG=0
