{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakdulur",
  "version": "0.1.0",
  "identifier": "com.fahmialfareza.sakdulur",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:4000",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Fahmi Alfareza",
    "copyright": "\u00a9 Fahmi Alfareza",
    "category": "Lifestyle",
    "shortDescription": "Family tree, built together",
    "longDescription": "Sakdulur is a private family tree you build together with your family: parents, partners and children across generations, with photos, stories and an AI assistant.",
    "homepage": "https://sakdulur.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "7FCMB3QMK7"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "com.fahmialfareza.sakdulur"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "com.fahmialfareza.sakdulur"
        ]
      }
    }
  }
}
