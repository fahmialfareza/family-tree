# Copy to .env (or set in the release workflows). Read at build time and baked into the app (vite.config.ts).

# The Go API (apps/backend-go). Its ALLOWED_ORIGINS must include tauri://localhost and http://tauri.localhost.
VITE_API_URL=http://localhost:4000
# The public website: invite links people share, and the Privacy/Terms pages the app opens.
VITE_SITE_URL=https://sakdulur.com

# Optional: Sentry for the app (errors, traces, replays on error, logs). Without a DSN nothing is sent.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Optional: upload source maps during the build (then deleted from dist).
SENTRY_ORG=
SENTRY_NATIVE_PROJECT=
SENTRY_AUTH_TOKEN=
